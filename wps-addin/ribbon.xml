<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
  <ribbon startFromScratch="false">
    <tabs>
      <tab id="rfqProjectTab" label="材料整理">
        <group id="rfqStages" label="三步完成">
          <button id="rfqStepImport" label="① 选清单并核对分类" size="large" tag="import" onAction="OnGotoStage" getImage="GetRfqImage"/>
          <button id="rfqStepBrands" label="② 填品牌和供应商" size="large" tag="brands" onAction="OnGotoStage" getImage="GetRfqImage"/>
          <button id="rfqStepInquiry" label="③ 生成供应商文件" size="large" tag="inquiry" onAction="OnGotoStage" getImage="GetRfqImage"/>
        </group>
        <group id="rfqWorkspace" label="更多">
          <button id="rfqOpenPane" label="打开材料整理助手" size="large" onAction="OnOpenRfqPane" getImage="GetRfqImage"/>
          <button id="rfqReloadPane" label="重建窗口" onAction="OnReloadRfqPane"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
